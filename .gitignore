# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ALL ignored. `.env` was previously force-tracked (`!.env`) because
# it held only the SQLite path and no secret (FINDINGS F8). That stopped being
# true the moment a live API key went into it, and this repo is PUBLIC — so the
# next commit would have published the key. Only the secret-free template is
# tracked now.
# (it only holds the local SQLite path, no secrets) so the app runs after clone.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database — recreated by `npm run setup`
/prisma/dev.db
/prisma/dev.db-journal

# uploaded media (photos, drawings) — recreated locally; not source
/public/uploads/*
!/public/uploads/.gitkeep

# Playwright test artifacts
/test-results
/playwright-report
/playwright/.cache

# Private uploaded media (served only via the authorising /uploads route)
.media/

# StoryJar's OWN library media, written here by
# scripts/ops/publish-shared-activities.mjs and by the test seed. GENERATED, not
# source: the source of truth is content/shared-activities/media, and in
# production these files live on the Railway volume at /data/media-shared.
#
# Four of them were committed by accident and shipped inside the container
# image, which made the library previews work for the wrong reason: the app's
# fallback path is <cwd>/.media-shared, so it was reading them out of the image
# rather than off the volume. That cannot survive activities authored on the
# canvas in StoryJar Academy, whose media will never be in git.
.media-shared/

# Root SQLite dev database (regenerated by npm run setup; never commit real data)
/dev.db
/dev.db-journal

# Per-shard test databases (scripts/run-suites.mjs)
prisma/dev-shard-*.db*

# Per-lane Next build output (scripts/run-suites.mjs)
.next-lane-*
