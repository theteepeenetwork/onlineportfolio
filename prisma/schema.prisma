// Data model for the online portfolio (a Seesaw-like class journal).
// SQLite has no native enums, so "type"/"status"/"role" fields are plain
// strings with their allowed values documented in comments next to them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A teacher owns one or more classes and moderates the journal.
model Teacher {
  id             String             @id @default(cuid())
  name           String // the teacher's full name (e.g. "Sam Pearson")
  title          String? // Mr / Miss / Mrs / Ms / Mx, or "" for "prefer not to say"
  displayStyle   String             @default("formal") // "formal" (title + surname) | "first"
  displayName    String? // computed greeting name, e.g. "Mr Pearson" or "Sam" — never derive the greeting from `name`
  email          String             @unique
  passwordHash   String
  schoolName     String? // captured at signup (Storyjar onboarding); free text
  country        String? // England / Scotland / Wales / NI / Elsewhere
  role           String             @default("TEACHER") // ADMIN | TEACHER | TA — position within the school
  status         String             @default("ACTIVE") // ACTIVE | INVITED (invited staff haven't set a password yet)
  // Signed up before launch day (1 Sept 2026) and promised free, unlimited
  // access permanently. STORED, never derived from `createdAt`: a promise you
  // can't identify the beneficiaries of is a promise you will break, and a
  // derived date stops being equivalent the first time rows are migrated or
  // imported. See docs/pricing-decisions.md. Not child data; no retention
  // implications beyond the teacher row itself.
  foundingMember Boolean            @default(false)
  school         School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId       String?
  createdAt      DateTime           @default(now())
  classes        Class[]
  sessions       Session[]
  templates      ActivityTemplate[]
  folders        Folder[]
  drafts         Draft[] // in-progress template drafts (cross-device autosave)
  // An individually-subscribing teacher's own subscription (null when the
  // teacher is covered by a school plan instead — see Subscription).
  subscription   Subscription?
}

// A school groups staff (teachers/TAs/admins) under one roof. Admins manage
// staff, class assignment and billing — but never see children's work unless
// they teach the class (that stays scoped to each teacher's own classes).
model School {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  staff        Teacher[]
  // The school's billing subscription (school plan). Null until one is created;
  // the plan label shown in the admin console is derived from this, not stored.
  subscription Subscription?
}

// A billing subscription that governs WRITE access for an account. An account is
// either one teacher (kind = FREE) or a whole school (kind = SCHOOL).
//
// Safeguarding notes:
//  - We store only Stripe identifiers here — never card/PAN data (rule 12).
//  - No child data ever lives on this record (hard constraint): a customer is
//    only ever a teacher's name/email or a school name, held in Stripe.
//  - `status` is the enforcement point read by requireWritableAccount(); FROZEN
//    means read-only. `frozenAt` starts the 12-month deletion clock in
//    RETENTION.md. Subscription rows are billing records (6-year retention).
//  - A FREE teacher plan is never FROZEN for non-payment (there is nothing to
//    pay), so children's work in a free account is never on a billing deletion
//    clock. Only a lapsed SCHOOL plan can start one. See RETENTION.md and
//    docs/pricing-decisions.md.
model Subscription {
  id                   String    @id @default(cuid())
  kind                 String // FREE (one teacher, all their classes) | SCHOOL (£299/yr flat)
  status               String    @default("ACTIVE") // TRIAL | ACTIVE | PAST_DUE | FROZEN
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // Only ever set on a SCHOOL plan being evaluated before a PO is raised. NULL
  // on every FREE teacher plan — a teacher account is never on a countdown
  // (docs/pricing-decisions.md: September adopters churn when a trial expires
  // mid-term). Tracked locally, never via Stripe trials.
  trialEndsAt          DateTime?
  frozenAt             DateTime? // when the account went read-only (starts the 12-month clock)
  currentPeriodEnd     DateTime? // end of the current paid period, synced from Stripe
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Exactly one of these is set (FREE → teacher, SCHOOL → school).
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String?  @unique
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String?  @unique
}

// Processed Stripe webhook event ids, so at-least-once redelivery is handled
// exactly once (idempotency). No personal data — just the event id and type.
model BillingEvent {
  id         String   @id // the Stripe event id (evt_...)
  type       String
  receivedAt DateTime @default(now())
}

// A teacher-defined folder for organising activity templates in the library.
model Folder {
  id        String             @id @default(cuid())
  name      String
  color     String             @default("#C9C2B0") // the sidebar dot colour
  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  createdAt DateTime           @default(now())
  templates ActivityTemplate[]
}

// A class groups students together and has a short code students use to log in.
model Class {
  id           String        @id @default(cuid())
  name         String
  yearGroup    String? // e.g. "Year 2" — captured at signup
  // Which child-facing register this class sees: "EYFS" (3–5), "KS1" (5–7) or
  // "KS2" (7–11). A teacher's per-class display choice, asked once at creation —
  // NOT data about a child. Nullable, and NULL means EYFS: the youngest, most
  // protective default (SAFEGUARDING rule 8 / Children's Code default-to-most-
  // protective; owner/DPO decision 2026-07-19), never inferred from `yearGroup`
  // (only the signup class has one, and it's free text). Resolve via
  // src/lib/ageMode.ts, never read this column raw. Retention: RETENTION.md.
  ageMode      String? // "EYFS" | "KS1" | "KS2"; NULL → EYFS
  classCode    String        @unique // e.g. "SUN234" — students type this to sign in
  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId    String
  createdAt    DateTime      @default(now())
  students     Student[]
  journalItems JournalItem[]
  assignments  Assignment[]
  drafts       Draft[]
}

// A student has no password — they pick their name from the class after
// entering the class code (mirrors how Seesaw handles young children).
model Student {
  id           String              @id @default(cuid())
  name         String
  avatarColor  String              @default("#4f46e5") // colour of their avatar bubble
  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId      String
  createdAt    DateTime            @default(now())
  // When this child last opened their jar. Approval happens while they're away,
  // so without this the reward lands in an empty room: anything approved after
  // this timestamp is new to them and drops into the jar when they next look.
  //
  // ONE timestamp, overwritten every visit — deliberately not a history. It is
  // wayfinding, never a measure of how often a child uses Storyjar. Never
  // aggregate, report or export it, and never show it to a parent: that is
  // profiling, which SAFEGUARDING rule 11 forbids. See RETENTION.md.
  jarSeenAt    DateTime?
  journalItems JournalItem[]
  sessions     Session[]
  assignments  AssignmentStudent[]
  parents      Parent[]            @relation("ParentChildren")
  drafts       Draft[] // in-progress activity-response drafts (cross-device autosave)
}

// A parent/carer with a read-only family view of their own child(ren)'s jar.
// They sign in with a teacher-issued family code or an emailed magic link — no
// password — and can only ever see approved moments for their linked children.
//
// A teacher NEVER types a parent's name or email. They create a family place for
// one child and hand the code to the school office to post home; the row exists
// from that moment with `name` and `email` both NULL. The parent fills either in
// themselves, and only if they want to (an email is needed solely for magic
// links). So Storyjar holds no contact detail for a parent unless that parent
// chose to give it. See docs/DPIA.md and RETENTION.md.
//
// `email` is nullable AND unique: SQLite treats every NULL as distinct, so any
// number of parents may have no address while a given address still belongs to
// at most one family. Never look a parent up by an empty/absent address — see
// requestMagicLink, which rejects a blank input before it reaches the database.
model Parent {
  id          String       @id @default(cuid())
  name        String?
  email       String?      @unique
  familyCode  String       @unique // the code printed on the school's letter
  createdAt   DateTime     @default(now())
  children    Student[]    @relation("ParentChildren")
  sessions    Session[]
  magicTokens MagicToken[]
}

// A single-use, expiring token behind a parent "magic link" email.
model MagicToken {
  id        String    @id @default(cuid())
  token     String    @unique
  parent    Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// A single piece of work in a student's journal.
model JournalItem {
  id              String      @id @default(cuid())
  type            String // PHOTO | TEXT | DRAWING | AUDIO
  caption         String? // optional short caption / the child's words
  textContent     String? // body text for TEXT items
  mediaPath       String? // relative /uploads path: cover image (PHOTO / DRAWING) or the voice-note file (AUDIO). Served ONLY via the authorising /uploads route, never publicly — same as photos (SAFEGUARDING rule 7).
  mediaPathsJson  String? // JSON array of paths for multi-page drawings; when set it supersedes mediaPath
  quizAnswersJson String? // JSON QuizAnswer[] — the child's multiple-choice selections (PENDING child content)
  quizScore       Int? // server-computed number of correct answers at submit time (null = not a quiz response)
  quizTotal       Int? // number of questions in the assignment snapshot at submit time
  status          String      @default("PENDING") // PENDING | APPROVED | RETURNED
  authorRole      String // STUDENT | TEACHER — who created the item
  teacherNote     String? // feedback the teacher leaves when returning work
  stickersJson    String? // JSON array of sticker KEYS (max 4) from the fixed catalog in src/lib/stickers.ts — keys only, look is derived
  praiseNote      String? // the teacher's kind note attached at approval time (shown to the child with the stickers)
  stickerReply    String? // "HEART" once the child sends one back — fixed value, never free text (SAFEGUARDING rule 2)
  returnMode      String? // when RETURNED: "CONTINUE" (reopen with their work) | "FRESH" (blank restart). null = not returned / legacy (treated as FRESH)
  student         Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  class           Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId         String
  skills          Skill[]     @relation("JournalItemSkills")
  createdAt       DateTime    @default(now())
  approvedAt      DateTime?
  // When set, this item is a response to an assignment (a run of a template).
  assignment      Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId    String?
}

// A reusable, class-agnostic activity a teacher can run again and again. The
// unit of organisation in the activity library. (Formerly `Activity`.)
model ActivityTemplate {
  id                String       @id @default(cuid())
  title             String
  instructions      String? // what to do; may be read aloud to the child
  templatePathsJson String? // JSON array of background image paths (canvas / PDF pages)
  quizJson          String? // JSON QuizPayload — floating multiple-choice questions; option imagePaths are /uploads paths
  objectsJson       String? // JSON TemplateObjects — movable pictures/shapes/text (per page); each carries a `locked` flag. Image srcs are /uploads paths
  tagsJson          String? // JSON array of teacher-defined tag names (e.g. ["Maths"])
  archived          Boolean      @default(false) // hidden from the grid; runs are kept
  teacher           Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId         String
  folder            Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId          String?
  createdAt         DateTime     @default(now())
  assignments       Assignment[]
}

// One run of a template against a class (whole class or chosen children).
// Title / instructions / template pages are snapshotted here at assign time so
// later edits to the template never change what a live run shows.
model Assignment {
  id                   String              @id @default(cuid())
  template             ActivityTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId           String
  class                Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId              String
  wholeClass           Boolean             @default(true)
  status               String              @default("LIVE") // LIVE | CLOSED
  title                String // snapshot at assign time
  instructions         String? // snapshot at assign time
  templateSnapshotJson String? // frozen template pages at assign time
  quizSnapshotJson     String? // frozen quiz definition at assign time (mirrors templateSnapshotJson)
  objectsSnapshotJson  String? // frozen movable-objects layer at assign time (mirrors templateSnapshotJson)
  dueDate              DateTime? // optional: when the run is expected done; null = no due date (open/historical)
  createdAt            DateTime            @default(now())
  students             AssignmentStudent[] // set only when wholeClass = false
  responses            JournalItem[]
  drafts               Draft[]
}

// An in-progress, unsubmitted draft synced to the account for cross-device
// resume (local-first autosave, Stage 2). Exactly one owner is set: a teacher
// (a new-template draft) OR a student (an activity-response draft). Composite
// pages are stored as MEDIA FILES (like real pages) and only their /uploads
// paths live in pagesJson — never multi-MB data URLs in a column.
//
// SAFEGUARDING: a child's draft is their private unfinished work. It is owner-
// scoped, never visible to parents/other children/other tenants, and never to a
// teacher (a teacher only sees the work once it's submitted as a JournalItem).
// Deletion is real (rows + media files), on submit/publish, on 30-day lazy
// expiry, and on owner cascade. See RETENTION.md.
model Draft {
  id         String   @id @default(cuid())
  surface    String // TEMPLATE_NEW | ACTIVITY_RESPONSE
  contextKey String // "tmpl-new" for a teacher, or the assignmentId for a response
  ownerKey   String // "t:<teacherId>" or "s:<studentId>" — the non-null uniqueness discriminator (nullable FKs alone can't dedupe in SQLite, where NULLs are distinct)
  pagesJson  String? // JSON array of /uploads paths (composite pages saved as media)
  fieldsJson String? // JSON of the wrapper's fields (title/instructions/tags OR caption)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime // now + retention; lazily purged (no cron)

  // Owner + context so cascade deletion and scoping are trivial. All Cascade so
  // a draft dies with its owner (teacher/student/class/assignment).
  teacher      Teacher?    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId    String?
  student      Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String?
  class        Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId      String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String?

  // One draft per (owner, context).
  @@unique([surface, contextKey, ownerKey])
  @@index([expiresAt])
}

// A chosen child on a "pick children" run. (Formerly `ActivityAssignment`.)
model AssignmentStudent {
  id           String     @id @default(cuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

// A skill / standard an item can be tagged against, so the journal doubles
// as assessment evidence. Shared across the whole app.
model Skill {
  id    String        @id @default(cuid())
  name  String        @unique
  items JournalItem[] @relation("JournalItemSkills")
}

// A login session. Points at a teacher, a student, or a parent.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  role      String // TEACHER | STUDENT | PARENT
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String?
  parent    Parent?  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// An append-only record of safeguarding-relevant actions (approvals, returns,
// deletions, staff/role changes) for accountability — SAFEGUARDING.md rule 16.
// Kept deliberately lightweight: actor, action, subject, time and a short note.
model AuditLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  schoolId    String? // for school-scoped viewing (from the actor's school)
  actorType   String // TEACHER | ADMIN | SYSTEM | PARENT (a parent linking their own second child, or adding their own email)
  actorId     String?
  actorName   String?
  action      String // e.g. MOMENT_APPROVED | MOMENT_RETURNED | STAFF_ROLE_CHANGED
  subjectType String? // e.g. JOURNAL_ITEM | STUDENT | TEACHER | CLASS
  subjectId   String?
  detail      String? // short human-readable summary

  @@index([schoolId, at])
}

// ---------------------------------------------------------------------------
// The platform operator (PR1 of the operator programme). NOT a school admin.
// ---------------------------------------------------------------------------
// `Teacher.role = "ADMIN"` already means "admin at this school" and must keep
// meaning only that, so the operator gets its own table, its own session table
// and its own cookie. getCurrentUser() must remain incapable of returning an
// operator and requireOperator() incapable of returning a teacher, student or
// parent; both directions are asserted in
// tests/battery/security/ops-auth.spec.ts (spec A21).
//
// Column names here are deliberately NOT the ones the blindness gate bans.
// Session.token and Teacher.passwordHash are credential names an operator must
// never read, so the operator's own columns are `tokenHash` and `pwHash`, which
// pass the gate's word-boundary matching. That is a naming constraint with a
// zero-cost remedy and it says the true thing: the operator's own secret is a
// different thing from a child's.
//
// Retention: RETENTION.md, "Platform operator account" and "Operator sessions
// and recovery codes". Purpose and residual risks: docs/DPIA.md R15.
model Operator {
  id                String            @id @default(cuid())
  email             String            @unique
  // bcrypt, cost 12 (OPS_BCRYPT_COST in src/lib/ops/passwords.ts).
  pwHash            String
  // Base32 TOTP secret. Stored in plaintext beside the database on the same
  // volume: encrypting it with a key from the environment would place the key
  // on the same host, so it buys less than it appears to. Recorded and accepted
  // in docs/DPIA.md R15 rather than left undocumented.
  totpSecret        String
  totpConfirmedAt   DateTime? // null until the operator has enrolled
  // Monotonic replay protection: a step less than OR EQUAL to this is refused,
  // so an attacker cannot replay the older code that is still inside the window.
  lastTotpStep      Int?
  // Ten single-use recovery codes, bcrypt-hashed, as
  // [{ "hash": "$2b$12$…", "usedAt": null }]. The plaintext is printed once by
  // scripts/seed-operator.ts and lives offline (docs/ops-recovery.md).
  recoveryCodesJson String            @default("[]")
  role              String            @default("OWNER") // OWNER | OPERATOR. One account exists (handbook D11); the split exists so "the last owner is protected" is expressible
  status            String            @default("ACTIVE") // ACTIVE | DISABLED
  // Lockout is persisted on the row, not held in the in-process rate limiter:
  // that store resets on every deploy and every restart, and this is the one
  // door where the attacker gets everything.
  failedAttempts    Int               @default(0)
  lockedUntil       DateTime?
  lastSignInAt      DateTime?
  createdAt         DateTime          @default(now())
  // Named opsSessions, not `sessions`: `sessions` is a relation to the app's
  // Session model elsewhere in this schema, and the blindness gate matches
  // relation names, not types.
  opsSessions       OperatorSession[]
}

// One row per operator browser session. Stores the SHA-256 hash of the cookie
// value and never the value, so a leaked database file is not a set of live
// sessions (the existing Session.token stores raw; that is pre-existing and out
// of scope here, and this deliberately does not copy it).
model OperatorSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  operatorId String
  // PASSWORD = password accepted, TOTP not yet proven; nothing but the sign-in
  // screen is reachable. FULL = both proven. The value is rotated (a new row,
  // a new cookie) at the moment TOTP succeeds, so a pre-auth identifier cannot
  // be fixated.
  stage      String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime // absolute cap; idle is enforced against lastSeenAt

  @@index([operatorId])
}

// The operator's own audit table (handbook ruling R4). Ops never reads
// AuditLog: its `detail` is free text written by teacher-facing actions and
// routinely contains a child's first name, so reading it would be a child-data
// read wearing an operations hat.
model OpsAuditLog {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  actorId        String? // null for a failed sign-in against an unknown address
  actorName      String
  action         String // e.g. OPS_SIGN_IN | OPS_SIGN_IN_FAILED | OPS_TOTP_FAILED
  subjectType    String?
  subjectId      String?
  reason         String? // the operator's stated reason, verbatim, on mutating actions
  detail         String? // never a child's name, never a credential value
  // Unique so QA can force a genuine constraint violation and prove that an
  // audit failure fails the operation (ruling R5), with no fault flag in the
  // product to do it with.
  idempotencyKey String?  @unique

  @@index([at])
}

// ---------------------------------------------------------------------------
// Mail delivery status, and the jobs that keep it current (PR5).
// ---------------------------------------------------------------------------
// Handbook ruling R9 fixes the storage model: "counters and HMAC-keyed
// suppression, and explicitly no address or domain". Owner decision D7, which
// would permit a per-recipient failure record, is unanswered and its published
// default is counters only, so counters only is what these three tables are.
//
// WHY NOT A ROW PER SEND, which is the obvious design and the one brief 03
// asked for. Three reasons, in the order they matter:
//
//   1. A visible list of sign-in failures by address rebuilds, inside Storyjar,
//      the account-enumeration signal that FINDINGS F6 deliberately withholds
//      from the public sign-in form. requestMagicLink answers the same way for
//      an address on file and one that is not; an operator screen listing
//      "delivery failed for ada@example.com" answers the question the form
//      refuses to. Counters cannot.
//   2. It is new personal data about adults on a 5 GB volume that has no
//      backups and holds every child's photograph (owner amendment B1, decision
//      D2 still open). The least data that answers the operational question is
//      the right amount.
//   3. Nothing operational needs it. "Is mail leaving Storyjar this morning"
//      and "is this one parent's address being refused" are both answerable
//      without a per-send row: the first from a tally, the second from a keyed
//      hash of the one address the operator already holds.
//
// None of these tables carries a recipient address, a recipient domain, a
// subject line or a message body. A sign-in email body contains a live token,
// so any code path that could persist a body is a token-disclosure bug, not a
// storage decision.

// One row per run of a scheduled job, so a job that never started is visible.
// Railway's cron does not alert on a non-zero exit and cannot alert at all on a
// run that did not happen, so the absence of a recent SUCCESS row is itself the
// signal (brief 05, "Both jobs must fail loudly").
//
// `outcomeDetail` holds a fixed vocabulary only. Never a recipient, never a
// path, never a count of children.
model JobRun {
  id            String    @id @default(cuid())
  job           String // fixed vocabulary: "mail:suppression-sync" today
  startedAt     DateTime
  finishedAt    DateTime?
  outcome       String // "SUCCESS" | "FAILURE"
  itemsAffected Int       @default(0)
  // A fixed vocabulary, never free text. Named outcomeDetail rather than the
  // obvious `note` because the blindness gate refuses a column whose name ends
  // in "note": AuditLog and JournalItem both carry notes that routinely hold a
  // child's first name, and a rule that has to know which `note` is which is a
  // rule that will one day guess wrong.
  outcomeDetail String?

  @@index([job, startedAt])
}

// A per-day, per-template, per-outcome tally of send ATTEMPTS, written from
// inside src/lib/mailer.ts by src/lib/mailCounters.ts. It says the same
// operational thing a delivery log would say without holding a row about a
// person: there is no address here, no domain, and no way to get from a row
// back to a family.
//
// `statusClass` is an empty string rather than NULL when there is nothing to
// say. SQLite treats NULLs as distinct in a unique constraint, so a nullable
// column in the key silently produces duplicate rows on upsert instead of
// incrementing the one that is already there.
//
// The vocabulary of all four key columns is closed and lives in
// src/lib/ops/mail.ts. The provider's own error strings are mapped onto it and
// never stored, so a provider that one day starts putting an address in a
// rejection message cannot put one in here.
model MailCounter {
  day         String // "YYYY-MM-DD", UTC
  // Named templateKey rather than `template` because `template` is a RELATION
  // to ActivityTemplate elsewhere in this schema, and the blindness gate
  // derives its child-relation denylist from relation names: an operator file
  // mentioning `template` is refused, whichever thing it meant. The gate cannot
  // tell a mail template from a child's activity template and should not try.
  templateKey String // "magic-link"
  outcome     String // "SENT" | "FAILED" | "UNCONFIGURED"
  statusClass String // "" | "4xx" | "5xx" | "other" | "rejected" | "timeout" | "network"
  count       Int    @default(0)

  @@id([day, templateKey, outcome, statusClass])
}

// One row per address the provider is refusing, keyed by an HMAC-SHA256 of the
// address under MAIL_HMAC_KEY, which lives in the environment and not in this
// repository.
//
// A plain hash of an email address is not a de-identification measure: the
// space of real addresses is small enough to walk with a dictionary, so an
// unkeyed digest is the address with extra steps. The key is what makes this
// row useless to somebody holding a copy of the database file and nothing else.
//
// It is a one-way column on purpose. An operator can ask "is THIS address, which
// I already have in front of me, being refused", by hashing it server-side from
// the stored adult record. Nobody can ask "which addresses are being refused",
// because that list is a list of adults locked out of their children's work and
// nothing operational needs it.
model MailSuppression {
  id          String   @id @default(cuid())
  addressHmac String   @unique
  state       String // "BOUNCE" | "BLOCKED" | "SPAM" | "UNSUBSCRIBED"
  firstSeenAt DateTime
  lastSeenAt  DateTime
}
