// Data model for the online portfolio (a Seesaw-like class journal).
// SQLite has no native enums, so "type"/"status"/"role" fields are plain
// strings with their allowed values documented in comments next to them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A teacher owns one or more classes and moderates the journal.
model Teacher {
  id             String             @id @default(cuid())
  name           String // the teacher's full name (e.g. "Sam Pearson")
  title          String? // Mr / Miss / Mrs / Ms / Mx, or "" for "prefer not to say"
  displayStyle   String             @default("formal") // "formal" (title + surname) | "first"
  displayName    String? // computed greeting name, e.g. "Mr Pearson" or "Sam" — never derive the greeting from `name`
  email          String             @unique
  passwordHash   String
  schoolName     String? // captured at signup (StoryJar onboarding); free text
  // The DfE URN of the school this teacher said they work at, when they picked
  // it from the register at signup rather than typing a name (Establishment).
  //
  // ALONGSIDE `schoolName`, NEVER INSTEAD OF IT. The free text is what the
  // teacher believes their school is called, and it is what the product and the
  // operator console display; this is the join key. Keeping both is what stops a
  // later re-import renaming a teacher's own school out from under them.
  //
  // NULL IS A REAL ANSWER, NOT A MISSING ONE, and this is the sentence to read
  // before "fixing" it. Null is what every teacher outside England has, because
  // GIAS is the English register and the picker is not even rendered for them.
  // It is also what an English teacher has whose school is missing from a
  // hand-run snapshot — schools open, close and merge constantly, and the
  // free-text path exists for exactly that and is first-class rather than
  // degraded. So a column full of nulls is the product working, NOT an
  // incomplete backfill waiting for somebody to finish it. Any future attempt to
  // populate these by matching names is the fuzzy guess docs/school-identity.md
  // exists to remove; it was considered and rejected there by name.
  //
  // NOT A RELATION, AND NOT INDEXED. A Prisma relation to Establishment would
  // pull that model into the ops blindness gate's relation-path logic for no
  // gain, and nothing joins on this column yet. It is a RECORDED IDENTIFIER
  // rather than a live pointer: the register is replaced wholesale on every
  // import, so a row it names can disappear, and no part of a person's account
  // may depend on a row a refresh can delete.
  //
  // `School.urn` NOW EXISTS, AND THIS IS NOT IT. An earlier version of this
  // comment said there was no such column and pointed forward to the step that
  // would add it; that step is
  // prisma/migrations/20260902090000_school_claim. The two columns are
  // different kinds of fact and must be read as such:
  //
  //   `Teacher.urn` is a RECORDED IDENTIFIER — what this teacher said their
  //   school was at signup. Nobody checked that they work there
  //   (docs/school-identity.md §5: matching a name is not evidence of
  //   employment), and `updateProfile` lets a teacher change `schoolName`
  //   without ever touching this, so it also goes stale when somebody moves
  //   schools.
  //
  //   `School.urn` is a CLAIM KEY — the register entry somebody paid for. It is
  //   `@unique`, because uniqueness belongs where the claim is, and it is what
  //   lets the product say "St Bede's is already on StoryJar, ask Mrs Lindqvist
  //   to add you" instead of quietly creating a second St Bede's.
  //
  // NEITHER IS DERIVED FROM THE OTHER AND THEY ARE NOT KEPT IN STEP. A teacher
  // whose `urn` equals some claimed `School.urn` is NOT a member of that school
  // and must never be treated as one — that is the auto-join
  // docs/school-identity.md §4 forbids by name. And a teacher who IS a member of
  // a claimed school, whose own `urn` is null or names somewhere else entirely,
  // is an ordinary person who moved jobs rather than a data fault to reconcile.
  //
  // It is checked against the register before it is stored (see
  // src/app/actions/auth.ts): a URN that is not in the register is worse than no
  // URN, because null is honest and a made-up key is a join somebody will one
  // day follow.
  //
  // Not personal data beyond the teacher row it sits on: it identifies an
  // institution, and every character of it is published by the DfE. Deleted with
  // the teacher by the same cascade as everything else on this row.
  urn            String?
  country        String? // England / Scotland / Wales / NI / Elsewhere
  role           String             @default("TEACHER") // ADMIN | TEACHER | TA — position within the school
  status         String             @default("ACTIVE") // ACTIVE | INVITED (invited staff haven't set a password yet)
  // Signed up before launch day (1 Sept 2026) and promised free, unlimited
  // access permanently. STORED, never derived from `createdAt`: a promise you
  // can't identify the beneficiaries of is a promise you will break, and a
  // derived date stops being equivalent the first time rows are migrated or
  // imported. See docs/pricing-decisions.md. Not child data; no retention
  // implications beyond the teacher row itself.
  foundingMember Boolean            @default(false)
  // When this teacher PROVED they can receive mail at `email`, by opening a
  // link sent to it. Null means unproved — the ordinary state of every account,
  // because free signup asks for nothing (docs/dpo-decisions.md, 2 Sep 2026).
  //
  // NULL IS THE COMMON CASE AND NOT A BACKLOG. Signup deliberately does not
  // verify: a mail-delivery dependency in front of every new teacher in the
  // busiest week of the school year fails the people who never say so. What
  // this column gates is BUYING — `startClaimCheckout` and `requestClaimInvoice`
  // refuse without it — because a teacher blocked at checkout is by definition
  // trying to give StoryJar money and will tell you. F67 stays open either way.
  //
  // WHAT IT IS NOT. It is not a sign-in condition, not a permission, and not a
  // fact about the person: it says a mailbox answered, nothing more. Do not read
  // it as "this teacher works at that school" — nothing in this product has ever
  // checked that (docs/school-identity.md §5), and a column that looked like
  // evidence of employment is exactly the fuzzy guess that document removes.
  //
  // STAMPED ONLY by src/app/confirm-email/route.ts, in the same transaction that
  // spends the CONFIRM token which authorised it. Never set by an admin, an
  // operator or a seed of real data; `prisma/seed*.ts` stamp fixtures because a
  // fixture that could not buy would fail every purchase spec.
  //
  // Not a new data category: it is a timestamp about an adult's own address,
  // which this row already holds. Deleted with the teacher by the same cascade.
  emailConfirmedAt DateTime?
  school         School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId       String?
  createdAt      DateTime           @default(now())
  classes        Class[]
  sessions       Session[]
  templates      ActivityTemplate[]
  folders        Folder[]
  drafts         Draft[] // in-progress template drafts (cross-device autosave)
  // An individually-subscribing teacher's own subscription (null when the
  // teacher is covered by a school plan instead — see Subscription).
  subscription   Subscription?
  // Bearer tokens this teacher has minted so Claude can build activities in
  // their library, and the claude.ai connector grants behind the OAuth ones.
  apiTokens      ApiToken[]
  oauthGrants    OAuthGrant[]
  // Outstanding password-reset and staff-invite tokens. Cascade on delete, the
  // same as sessions: deleting a teacher must not leave a live link behind.
  passwordTokens TeacherPasswordToken[]
  // Offers of school membership made TO this teacher, and separately the ones
  // they made as an admin. Two relations because both ends of a
  // SchoolInvitation are a Teacher; the names are the disambiguator Prisma
  // requires and carry no meaning beyond that. Both cascade on delete, the
  // same as sessions and password tokens.
  schoolInvitations     SchoolInvitation[] @relation("SchoolInvitationInvitee")
  sentSchoolInvitations SchoolInvitation[] @relation("SchoolInvitationInviter")
}

// A school groups staff (teachers/TAs/admins) under one roof. Admins manage
// staff, class assignment and billing — but never see children's work unless
// they teach the class (that stays scoped to each teacher's own classes).
model School {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  // What this school IS. "SCHOOL" is a real customer; "DEMO" is StoryJar
  // Academy, the fictional school StoryJar staff work and troubleshoot in.
  //
  // The Academy is a REAL tenant on purpose. A sandbox that is a special case in
  // the code stops resembling the thing it rehearses, and the bug you are
  // chasing lives in the ordinary path. So it is scoped exactly like St Bede's,
  // and this column is not an access control: nothing may read "DEMO" and
  // decide to relax a rule.
  //
  // What it IS for is figures. The Academy must never appear in the pupil rolls,
  // price bands or revenue the operator console reports, or StoryJar's own
  // numbers quietly include several hundred children who do not exist.
  kind         String        @default("SCHOOL")
  // May staff of this school publish a template into the shared library?
  //
  // False everywhere except the Academy, and settable only by a seed or a
  // migration. There is deliberately no screen, no action and no operator
  // control that writes it, which is what keeps "only StoryJar publishes" true
  // while letting it be done on the real canvas, in a real teacher account.
  canPublishToLibrary Boolean @default(false)

  // ---------------------------------------------------------------------------
  // THE CLAIM. Three columns saying which register entry this school was bought
  // as, whether the money arrived, and who paid. docs/paid-tier-plan.md item 0,
  // docs/school-identity.md §3.
  //
  // TWO WRITERS, AND ONLY TWO. `src/lib/schoolClaim.ts` takes the claim;
  // `src/lib/urnRelease.ts` gives it back when an unverified school freezes
  // (docs/dpo-decisions.md, 2 Sep 2026). This comment read "written only by
  // src/lib/schoolClaim.ts" until the release existed. A third writer belongs in
  // this list before it belongs in the code.
  // ---------------------------------------------------------------------------

  // The DfE URN this school was CLAIMED as. Distinct from `Teacher.urn`, which
  // is only what a teacher said at signup — read the long comment there before
  // assuming either follows from the other.
  //
  // NULLABLE AND @unique TOGETHER, AND THAT PAIRING IS THE DESIGN, not an
  // accident to tighten later. SQLite treats every NULL as distinct, so the
  // index constrains nothing at all about the nulls: unlimited free-text schools
  // coexist happily, and the constraint bites on exactly one thing — two schools
  // claiming the same register entry. That is what lets the product refuse a
  // second claim with a sentence naming the school and its admin, instead of
  // quietly creating a duplicate school with a second admin standing over the
  // same children's teachers.
  //
  // TWO PRECEDENTS, AND BOTH OF THEM ARE REAL. `Parent.email` is where the
  // SQLite null semantics were reasoned out first — its comment sits above
  // `model Parent` rather than inline beside the field, and it says the same
  // thing in the same words. `ActivityTemplate.librarySlug` is the one that
  // shows the SQL: Prisma emitted it as a plain CREATE UNIQUE INDEX in
  // 20260901090000_library_publishing, which is exactly the statement this
  // column's migration writes by hand.
  //
  // docs/paid-tier-plan.md cites `Parent.email`, AND IT IS RIGHT TO. A note in
  // the item-0 work plan says that column carries no comment and that this one
  // should cite `librarySlug` instead — checked on 1 Sep 2026, the comment is
  // there. Do not "correct" the citation in paid-tier-plan.md; it is correct.
  //
  // A SCALAR, WITH NO RELATION TO Establishment, deliberately. The register is
  // deleted and rebuilt wholesale on every import (scripts/gias-import.ts), so a
  // foreign key would let a closure or a merge take a paying customer's identity
  // with it, and it would pull Establishment into the ops gate's relation-path
  // logic for nothing. THE CLAIM SNAPSHOTS RATHER THAN JOINING: `School.name` is
  // copied at claim time and never follows a GIAS rename, so a customer's
  // invoice does not change because of a data refresh.
  //
  // THE NAME IS ALL THAT IS SNAPSHOTTED — not postcode, local authority or town
  // (owner decision, 1 Sep 2026, partially reversing decision (a) of 24 Aug,
  // where the full reasoning now lives in scripts/gias-import.ts). `School.name`
  // alone serves that decision's stated reason, and `postcode` is a field name
  // scripts/check-ops-blindness.mjs deliberately DENIES to the operator area
  // rather than exempting, so `School.postcode` would widen that gate's surface
  // for a column no screen reads.
  //
  // IT GOES BACK TO NULL WHEN AN UNVERIFIED SCHOOL FREEZES (owner decision,
  // 2 Sep 2026). A purchase order costs the person raising it nothing, so
  // without a release a squatter held a register entry for ever and only the
  // founder could clear it. Releasing takes NOTHING ELSE: the school row, its
  // staff, its classes and every child's work stay exactly where they are, and
  // the school reclaims the URN by buying again — the same act that claimed it.
  // A school that PAID and later lapsed keeps its claim; `verifiedAt` below is
  // the line, and src/lib/urnRelease.ts denies the release if it cannot read it.
  //
  // Not personal data: it identifies an institution, and every character of it
  // is published by the DfE under the Open Government Licence.
  urn                 String?   @unique

  // When payment for this school was CONFIRMED. Null means arranged but not yet
  // paid for — a real state, not a missing value.
  //
  // ONLY THE INVOICE / PO ROUTE CAN PRODUCE IT. `requestSchoolInvoice` creates
  // the school ACTIVE and unverified, because a 30-day invoice is unpaid by
  // definition and finance holding it must not freeze a school; `verifiedAt` is
  // stamped on `invoice.paid`. A card purchase creates AND verifies inside one
  // transaction and never passes through this state at all
  // (docs/pricing-decisions.md, 1 Sep 2026: no trial on new purchases, a 42-day
  // full refund instead).
  //
  // WHAT NULL COSTS A SCHOOL, exactly: no `assignClassToStaff`, no `removeStaff`
  // on a colleague who has already joined, and no promotion to ADMIN — the three
  // powers that hand one adult oversight of another adult's pupils
  // (docs/dpo-decisions.md, 30 Aug + 1 Sep 2026). `removeStaff` on an INVITED
  // row stays allowed, and so does inviting staff, the audit log, billing and
  // all of teaching.
  //
  // A MISSING SCHOOL ROW READS AS UNVERIFIED, never as "assume fine": that is
  // rule 8, deny by default, and `schoolIsVerified` in src/lib/schoolClaim.ts is
  // where it is implemented.
  verifiedAt          DateTime?

  // Which teacher account paid for this school. A bare id, WITH NO FOREIGN KEY,
  // and that is a decision rather than an oversight to tidy up.
  //
  // A relation would have to be `onDelete: SetNull` (the only safe option —
  // Cascade would delete a whole school because one member of staff closed their
  // account), and SetNull would erase the one fact a disputed claim asks about:
  // who claimed this school, at the time, under whose name the money moved. A
  // claim record that deletes itself when the claimant leaves is not a record.
  //
  // IT IS LOAD-BEARING, NOT ARCHAEOLOGICAL. docs/pricing-decisions.md (1 Sep
  // 2026) requires a refund to detach THE BUYER back to their own free plan
  // rather than freezing them alongside the school, and nothing else in this
  // schema can say which member of staff that was:
  // `customer.subscription.deleted` resolves a Subscription and gets a
  // `schoolId`, and a school has many staff. `detachBuyer` in
  // src/lib/schoolClaim.ts is the consumer.
  //
  // Because there is no FK, EVERY READER MUST TREAT IT AS POSSIBLY DANGLING: the
  // teacher may have deleted their account, or may have been removed and moved
  // on. `detachBuyer` re-reads the teacher and checks they still point at THIS
  // school before touching anything.
  claimedByTeacherId  String?

  staff        Teacher[]
  // The school's billing subscription (school plan). Null until one is created;
  // the plan label shown in the admin console is derived from this, not stored.
  subscription Subscription?
  // Offers this school has made to teachers who already hold their own
  // account. Not a second staff list: a row here is a question, and only
  // `Teacher.schoolId` is an answer.
  invitations  SchoolInvitation[]
}

// An OFFER of school membership, made to a teacher who ALREADY HAS a StoryJar
// account of their own.
//
// It exists because `inviteStaff` (src/app/actions/admin.ts) refuses an email
// that already belongs to a teacher, flatly. A teacher who signed up free in
// September therefore cannot be brought into their school when it buys in
// January — the ordinary case rather than an edge one, and the last thing
// standing between a school paying and its staff using what it paid for.
// docs/dpo-decisions.md (1 Sep 2026), docs/paid-tier-plan.md.
//
// THIS IS A MEMBERSHIP RECORD, NOT A CREDENTIAL. It is filed here, beside
// School in the billing and adult-account half of this file, and deliberately
// NOT beside TeacherPasswordToken, so that a reader arriving at it does not
// begin by assuming it holds a secret. It does not.
//
// ---------------------------------------------------------------------------
// THERE IS NO SECRET COLUMN, AND THAT IS THE DESIGN
// ---------------------------------------------------------------------------
// Nothing here is named `*Hash`, `*Token`, `*Code` or `*Secret`, so nothing
// trips SENSITIVE_NAME_PATTERNS in scripts/check-ops-blindness.mjs and nothing
// needs a DENY_FIELDS entry. That is a CONSEQUENCE, not the reason. The reason
// is the owner decision of 1 September 2026: this invitation is answered IN THE
// APP BY THE SIGNED-IN ACCOUNT HOLDER, so there is nobody for a bearer token to
// be issued to. The invitee is already authenticated; a mailed secret would be
// a second way in to an account that already has one.
//
// SO AN `inviteCode` "SO IT CAN BE FORWARDED" IS THE CHANGE TO REFUSE. It would
// recreate — after MagicToken and TeacherPasswordToken — the third bearer
// credential in this product, and it would do it on the highest-value action in
// it: accepting hands a school authority over this teacher's classes and the
// children in them. "Forwardable" means "works for whoever is holding it", and
// what would be handed over is not this teacher's account, it is their pupils.
// A notification email may say an invitation is waiting; it may not carry one.
//
// ---------------------------------------------------------------------------
// WHY NOT COLUMNS ON TeacherPasswordToken
// ---------------------------------------------------------------------------
// Because `mintPasswordToken` (src/lib/passwordTokens.ts) SPENDS every unspent
// token in the password-setting pool each time it mints another. An invitation
// filed there as a fourth `purpose` would be cancelled silently the next time
// the teacher asked for a password reset, and the banner offering it would
// vanish with nothing on any screen explaining why.
//
// That is a live edge rather than a theory: it is exactly what CONFIRM hit in
// prisma/migrations/20260902150000_teacher_email_confirmation, which is why
// confirmation was given its own pool. A pool is the right answer THERE,
// because a confirmation is still a mailed secret with a lifetime. It is the
// wrong answer here. An invitation is not a secret at all, and a table whose
// entire purpose is "single-use expiring credential, stored as a digest" is the
// wrong cabinet for a record that a school and a teacher both have to be able
// to look at and talk about.
//
// ---------------------------------------------------------------------------
// ONE ROW PER (TEACHER, SCHOOL), MUTATED THROUGH STATES
// ---------------------------------------------------------------------------
// `@@unique([teacherId, schoolId])`. Re-inviting somebody is an UPSERT back to
// PENDING with a fresh clock, never a second row, so "does this teacher have an
// open offer from us?" is one lookup with one answer and there is no
// newest-row tie for two readers to break differently.
//
// History is not lost; it is kept where this codebase already keeps history.
// src/app/admin/page.tsx reconstructs which teacher held which class entirely
// from CLASS_ASSIGNED audit rows rather than from a column, for exactly this
// reason: the log is the record, and a column is the current state.
//
// THE LEADING COLUMN IS teacherId, AND THERE IS NO SECOND INDEX. The read that
// happens constantly is the teacher's — the shell asks "do I have an open
// offer?" on EVERY navigation — and a composite index is usable on its leading
// column alone, so that read is covered. The school's read, an admin opening
// one console page, scans a table holding one row per outstanding offer. That
// is cheaper than an index maintained on every write, and if it ever stops
// being cheaper the fix is one line here.
//
// NO GLOBAL UNIQUE ON teacherId. A supply teacher genuinely can be asked by two
// schools at once, and a unique constraint there would make the second school's
// invitation fail with a database error instead of arriving. What stops a
// teacher belonging to two schools is ACCEPTANCE — `Teacher.schoolId` is a
// single column, and accepting supersedes the other open offers — not a
// constraint on being asked.
//
// ---------------------------------------------------------------------------
// EXPIRY IS A PAST `expiresAt`, NOT A STATE
// ---------------------------------------------------------------------------
// There is no EXPIRED value in `state` and there is no job that would write
// one. An offer is open when its state is PENDING and its clock has not run
// out, and both halves are read together by `schoolInvitationIsOpen` in
// src/lib/schoolInvitationPolicy.ts. A state would need a sweeper to be true; a
// sweeper that stops running is a silent widening; and a sweeper's absence
// looks exactly like an offer that is still open. Nothing to schedule, nothing
// to drift.
//
// ---------------------------------------------------------------------------
// WHAT IS IN IT, FOR THE DPIA
// ---------------------------------------------------------------------------
// Two adults and a school: the invitee, the inviter, the school, a role from a
// three-word vocabulary, the name the ADMIN TYPED, and four timestamps. No
// child, no address, no free text a child's name could reach, no credential and
// no new sub-processor. Nothing the Teacher rows at either end do not already
// hold. Deleted with either adult, and with the school, by the cascades below.
model SchoolInvitation {
  id                 String    @id @default(cuid())

  // The school making the offer. Cascade: if the school row goes, an offer to
  // join it is not a record of anything.
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId           String

  // The teacher being asked. Cascade for the reason Session and
  // TeacherPasswordToken cascade: closing an account must not leave something
  // behind that still names the person who closed it.
  teacher            Teacher   @relation("SchoolInvitationInvitee", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId          String

  // ADMIN | TEACHER | TA — the SAME closed vocabulary as `Teacher.role`, in the
  // same words rather than a parallel set, because this value is copied onto
  // the teacher when they accept. Checked in src/lib/schoolInvitationPolicy.ts
  // before a row is written; SQLite has no enum, which is why Teacher.role and
  // Teacher.status are strings too.
  //
  // NO DEFAULT. The role is a choice an admin makes on a form, and a default
  // here is a way to write the wrong one quietly. Whether ADMIN may be OFFERED
  // is a separate rule about the school, not about this column: an unverified
  // school may not (docs/dpo-decisions.md, 2 Sep 2026).
  role               String

  // THE NAME THE ADMIN TYPED, NEVER THE ACCOUNT'S OWN. This is a safeguarding
  // decision wearing a display field's clothes, and it does two jobs.
  //
  // Rendering `Teacher.name` instead would disclose an adult's real name to
  // somebody who supplied only an email address: an admin who typed a
  // colleague's address would be told what that person is called, which they
  // did not know a moment earlier.
  //
  // And it would make a pending invitation LOOK DIFFERENT in the staff list
  // from a fresh INVITED row — which is exactly the difference the four-case
  // `inviteStaff` branch exists to erase. "No account here" and "an account,
  // now invited" must be indistinguishable to the admin, or the invite form is
  // FINDINGS F6's account-existence oracle with better manners.
  invitedName        String

  // WHO ASKED: a nullable pointer, plus the name snapshotted as text.
  //
  // SetNull, because an inviter can leave the school or close their account and
  // neither of those may delete an offer somebody is still holding. The
  // snapshot is what makes SetNull safe — "Mrs Lindqvist asked you to join
  // Oakfield" survives Mrs Lindqvist, and that sentence is what the acceptance
  // screen has to be able to say before a teacher hands over their classes.
  //
  // Compare School.claimedByTeacherId, which answers the same problem the other
  // way round: no foreign key at all, because there is no name column there to
  // carry the fact once the pointer has gone.
  invitedBy          Teacher?  @relation("SchoolInvitationInviter", fields: [invitedByTeacherId], references: [id], onDelete: SetNull)
  invitedByTeacherId String?
  invitedByName      String

  // PENDING | ACCEPTED | DECLINED | REVOKED | SUPERSEDED. Closed vocabulary,
  // enforced in src/lib/schoolInvitationPolicy.ts.
  //
  // The last three are three values rather than one "closed", because they are
  // answers to different questions and a support call asks which: DECLINED is
  // the teacher's answer, REVOKED is the school taking it back, and SUPERSEDED
  // is what happens to every other open offer the moment a teacher accepts one
  // — nobody did anything, and it must not read as though somebody did.
  //
  // NO `EXPIRED`. See the note above the model.
  state              String    @default("PENDING")

  // When the offer stops being answerable. 14 days; the number and the argument
  // for it are in src/lib/schoolInvitationPolicy.ts, in one place so it can be
  // overruled in one place.
  expiresAt          DateTime

  // When the teacher answered, whichever way. Null while PENDING. Not derivable
  // from `updatedAt`, which also moves when a school revokes or when acceptance
  // elsewhere supersedes this row.
  respondedAt        DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([teacherId, schoolId])
}

// A billing subscription that governs WRITE access for an account. An account is
// either one teacher (kind = FREE) or a whole school (kind = SCHOOL).
//
// Safeguarding notes:
//  - We store only Stripe identifiers here — never card/PAN data (rule 12).
//  - No child data ever lives on this record (hard constraint): a customer is
//    only ever a teacher's name/email or a school name, held in Stripe.
//  - `status` is the enforcement point read by requireWritableAccount(); FROZEN
//    means read-only. `frozenAt` starts the 12-month deletion clock in
//    RETENTION.md. Subscription rows are billing records (6-year retention).
//  - A FREE teacher plan is never FROZEN for non-payment (there is nothing to
//    pay), so children's work in a free account is never on a billing deletion
//    clock. Only a lapsed SCHOOL plan can start one. See RETENTION.md and
//    docs/pricing-decisions.md.
model Subscription {
  id                   String    @id @default(cuid())
  kind                 String // FREE (one teacher, all their classes) | SCHOOL (£299/yr flat)
  status               String    @default("ACTIVE") // TRIAL | ACTIVE | PAST_DUE | FROZEN
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // Only ever set on a SCHOOL plan being evaluated before a PO is raised. NULL
  // on every FREE teacher plan — a teacher account is never on a countdown
  // (docs/pricing-decisions.md: September adopters churn when a trial expires
  // mid-term). Tracked locally, never via Stripe trials.
  trialEndsAt          DateTime?
  frozenAt             DateTime? // when the account went read-only (starts the 12-month clock)
  currentPeriodEnd     DateTime? // end of the current paid period, synced from Stripe
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Exactly one of these is set (FREE → teacher, SCHOOL → school).
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String?  @unique
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String?  @unique
}

// Processed Stripe webhook event ids, so at-least-once redelivery is handled
// exactly once (idempotency). No personal data — just the event id and type.
model BillingEvent {
  id         String   @id // the Stripe event id (evt_...)
  type       String
  receivedAt DateTime @default(now())
}

// A teacher-defined folder for organising activity templates in the library.
model Folder {
  id        String             @id @default(cuid())
  name      String
  color     String             @default("#C9C2B0") // the sidebar dot colour
  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  createdAt DateTime           @default(now())
  templates ActivityTemplate[]
}

// A class groups students together and has a short code students use to log in.
model Class {
  id           String        @id @default(cuid())
  name         String
  yearGroup    String? // e.g. "Year 2" — captured at signup
  // Which child-facing register this class sees: "EYFS" (3–5), "KS1" (5–7) or
  // "KS2" (7–11). A teacher's per-class display choice, asked once at creation —
  // NOT data about a child. Nullable, and NULL means EYFS: the youngest, most
  // protective default (SAFEGUARDING rule 8 / Children's Code default-to-most-
  // protective; owner/DPO decision 2026-07-19), never inferred from `yearGroup`
  // (only the signup class has one, and it's free text). Resolve via
  // src/lib/ageMode.ts, never read this column raw. Retention: RETENTION.md.
  ageMode      String? // "EYFS" | "KS1" | "KS2"; NULL → EYFS
  classCode    String        @unique // e.g. "SUN234" — students type this to sign in
  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId    String
  createdAt    DateTime      @default(now())
  students     Student[]
  journalItems JournalItem[]
  assignments  Assignment[]
  drafts       Draft[]
}

// A student has no password — they pick their name from the class after
// entering the class code (mirrors how Seesaw handles young children).
model Student {
  id           String              @id @default(cuid())
  name         String
  avatarColor  String              @default("#4f46e5") // colour of their avatar bubble
  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId      String
  createdAt    DateTime            @default(now())
  // When this child last opened their jar. Approval happens while they're away,
  // so without this the reward lands in an empty room: anything approved after
  // this timestamp is new to them and drops into the jar when they next look.
  //
  // ONE timestamp, overwritten every visit — deliberately not a history. It is
  // wayfinding, never a measure of how often a child uses StoryJar. Never
  // aggregate, report or export it, and never show it to a parent: that is
  // profiling, which SAFEGUARDING rule 11 forbids. See RETENTION.md.
  jarSeenAt    DateTime?
  journalItems JournalItem[]
  sessions     Session[]
  assignments  AssignmentStudent[]
  parents      Parent[]            @relation("ParentChildren")
  drafts       Draft[] // in-progress activity-response drafts (cross-device autosave)
}

// A parent/carer with a read-only family view of their own child(ren)'s jar.
// They sign in with a teacher-issued family code or an emailed magic link — no
// password — and can only ever see approved moments for their linked children.
//
// A teacher NEVER types a parent's name or email. They create a family place for
// one child and hand the code to the school office to post home; the row exists
// from that moment with `name` and `email` both NULL. The parent fills either in
// themselves, and only if they want to (an email is needed solely for magic
// links). So StoryJar holds no contact detail for a parent unless that parent
// chose to give it. See docs/DPIA.md and RETENTION.md.
//
// `email` is nullable AND unique: SQLite treats every NULL as distinct, so any
// number of parents may have no address while a given address still belongs to
// at most one family. Never look a parent up by an empty/absent address — see
// requestMagicLink, which rejects a blank input before it reaches the database.
model Parent {
  id          String       @id @default(cuid())
  name        String?
  email       String?      @unique
  familyCode  String       @unique // the code printed on the school's letter
  createdAt   DateTime     @default(now())
  children    Student[]    @relation("ParentChildren")
  sessions    Session[]
  magicTokens MagicToken[]
}

// A single-use, expiring token behind a parent "magic link" email.
model MagicToken {
  id        String    @id @default(cuid())
  token     String    @unique
  parent    Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// A single-use, expiring token that lets an ADULT set a password.
//
// ONE MODEL, TWO PURPOSES, and that is a decision rather than an economy. A
// forgotten password and a staff invitation are the same mechanism — mint a
// random secret, mail a link, let the person who opened it write a new hash
// once — and two models would be two copies of that mechanism, drifting apart
// the first time one of them was fixed. What actually differs between the two
// is carried by `purpose`: how long the token lasts, which audit action a
// completed set writes, and whether the REQUEST path has to be neutral (a
// reset does, because anyone may ask for one; an invite is triggered by a
// colleague who is already signed in).
//
// `purpose` is a closed vocabulary, "RESET" or "INVITE", checked in code
// before a row is written. SQLite has no enum, which is the same reason
// Session.role and JournalItem.status are strings here.
//
// THE TOKEN IS STORED HASHED, NEVER RAW. `resetHash` is the SHA-256 hex digest
// of the 24 random bytes that went out in the email, and the raw token exists
// only in that message and in the request that spends it. The reason is that a
// database READ must not be replayable into an account takeover: with raw
// storage, anyone who can see this table for the lifetime of a token owns any
// account with an outstanding reset. That is not hypothetical here. FINDINGS
// F20 records that volume backups now exist, F35 that nobody has confirmed
// which country they sit in, and docs/exceptional-access.md describes a route
// by which a human deliberately reads rows. A stolen dev.db, a leaked backup
// and an authorised look are all the same shape of event, and after this
// decision none of them yields a working link.
//
// SHA-256 AND NOT BCRYPT, DELIBERATELY. Slow KDFs exist to defend secrets
// people choose; this secret is 24 bytes from `randomBytes` — 192 bits, not
// guessable, with no dictionary to run against it. bcrypt would buy nothing
// for that and would cost a KDF on every lookup, and it silently truncates its
// input at 72 bytes, which is a trap to leave lying around. A single fast
// digest is the right primitive for a high-entropy bearer token.
//
// Lookup is BY HASH: the caller digests the token from the URL and reads this
// unique index. So hashing costs no scan and no extra query — the index does
// exactly the work it did before.
//
// THIS DIVERGES FROM MagicToken ABOVE, WHICH STORES ITS TOKEN RAW, AND THE
// DIVERGENCE IS THE POINT. MagicToken's raw storage is a weakness to be
// corrected on its own terms, not a house style for new tables to match; it is
// left alone in this commit because changing the parent sign-in path is a
// separate, safeguarding-reviewed change and not something to smuggle in
// beside a teacher feature. Anyone adding a third token table should copy this
// model, not that one.
model TeacherPasswordToken {
  id        String    @id @default(cuid())
  // Named resetHash, not tokenHash, for the reason ApiToken.keyHash gives above:
  // OperatorSession already owns `tokenHash`, the ops blindness gate's denylist
  // is keyed on the column NAME, and denylisting that name would either break
  // the operator's own sign-in or leave this column unprotected. Two
  // credentials, two names, both denied. This model was first written with
  // `tokenHash` and renamed the same morning — the gate passed either way,
  // because the model's CREDENTIAL_NEVER classification already permits
  // nothing, but a name that can never be added to DENY_FIELDS is protected by
  // one control where every other teacher credential has two.
  resetHash String    @unique // SHA-256 hex of the raw token. The raw token is never stored.
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  // RESET | INVITE | CONFIRM.
  //
  // The first two SET A PASSWORD and share one pool: `mintPasswordToken` spends
  // every unspent RESET or INVITE the teacher holds when it mints another, so
  // only one password-setting link is ever live. CONFIRM sets no password — it
  // proves a mailbox answered — so it has its own pool and its own minting
  // function, and the two must not spend each other. A reset that killed an
  // outstanding confirmation would block a teacher at checkout with a dead link
  // in their inbox.
  //
  // The vocabulary is closed and enforced in src/lib/passwordTokenPolicy.ts, and
  // BOTH consumers check the purpose they expect. `setPassword` refuses a
  // CONFIRM token: a confirmation link is sent to an address NOBODY HAS PROVED
  // YET, so a token that could also set a password would hand a mistyped
  // stranger the account.
  purpose   String
  expiresAt DateTime
  usedAt    DateTime? // set in the same transaction as the password write, which is what makes it single-use
  createdAt DateTime  @default(now())
}

// A single piece of work in a student's journal.
model JournalItem {
  id              String      @id @default(cuid())
  type            String // PHOTO | TEXT | DRAWING | AUDIO
  caption         String? // optional short caption / the child's words
  textContent     String? // body text for TEXT items
  mediaPath       String? // relative /uploads path: cover image (PHOTO / DRAWING) or the voice-note file (AUDIO). Served ONLY via the authorising /uploads route, never publicly — same as photos (SAFEGUARDING rule 7).
  mediaPathsJson  String? // JSON array of paths for multi-page drawings; when set it supersedes mediaPath
  // JSON array of PICTURE paths, one per page: the work as it LOOKED, with the
  // question boxes drawn on. Written only when the page carries a quiz, because
  // that is the only thing the flattened pages leave out for a pupil. The work
  // of record stays `mediaPathsJson` — a child's drawing is never published
  // with question boxes baked into it — so these two are allowed to differ, and
  // only the read-only surfaces (the queue, the viewer, the jar) use this one.
  previewPathsJson String?
  quizAnswersJson String? // JSON QuizAnswer[] — the child's multiple-choice selections (PENDING child content)
  quizScore       Int? // server-computed number of correct answers at submit time (null = not a quiz response)
  quizTotal       Int? // number of questions in the assignment snapshot at submit time
  status          String      @default("PENDING") // PENDING | APPROVED | RETURNED
  authorRole      String // STUDENT | TEACHER — who created the item
  teacherNote     String? // feedback the teacher leaves when returning work
  stickersJson    String? // JSON array of sticker KEYS (max 4) from the fixed catalog in src/lib/stickers.ts — keys only, look is derived
  praiseNote      String? // the teacher's kind note attached at approval time (shown to the child with the stickers)
  stickerReply    String? // "HEART" once the child sends one back — fixed value, never free text (SAFEGUARDING rule 2)
  returnMode      String? // when RETURNED: "CONTINUE" (reopen with their work) | "FRESH" (blank restart). null = not returned / legacy (treated as FRESH)
  student         Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  class           Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId         String
  skills          Skill[]     @relation("JournalItemSkills")
  createdAt       DateTime    @default(now())
  approvedAt      DateTime?
  // When set, this item is a response to an assignment (a run of a template).
  assignment      Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId    String?
}

// A reusable, class-agnostic activity a teacher can run again and again. The
// unit of organisation in the activity library. (Formerly `Activity`.)
model ActivityTemplate {
  id                     String          @id @default(cuid())
  title                  String
  instructions           String? // what to do; may be read aloud to the child
  templatePathsJson      String? // JSON array of background image paths (canvas / PDF pages)
  // JSON array of PICTURE paths, one per page: the background with the movable
  // pieces and the question boxes drawn on. `templatePathsJson` is deliberately
  // partial — objects are left out so they don't appear twice when the template
  // is reopened for editing, and questions are never flattened at all — which
  // meant a template made of pieces and questions showed a blank white card.
  // This is what a human is shown; that is what the editor is given back.
  previewPathsJson       String?
  quizJson               String? // JSON QuizPayload — floating multiple-choice questions; option imagePaths are /uploads paths
  objectsJson            String? // JSON TemplateObjects — movable pictures/shapes/text (per page); each carries a `locked` flag. Image srcs are /uploads paths
  tagsJson               String? // JSON array of teacher-defined tag names (e.g. ["Maths"])
  archived               Boolean         @default(false) // hidden from the grid; runs are kept
  teacher                Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId              String
  folder                 Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId               String?
  // Where this template came from, when a teacher added it from the StoryJar
  // library. It is provenance and nothing else: the row and its media are a
  // full copy, so the template works forever whatever happens to the original.
  // SetNull, not Cascade: removing a shared activity must never remove a
  // teacher's own copy of it (see FINDINGS F27 for why copying strings rather
  // than files is the trap this avoids).
  sourceShared           SharedActivity? @relation(fields: [sourceSharedActivityId], references: [id], onDelete: SetNull)
  sourceSharedActivityId String?
  // The slug of the library activity this template was published AS, when it
  // was published by StoryJar staff from the Academy. Null for every template
  // at every real school, forever.
  //
  // A plain string and deliberately NOT a relation. SharedActivity's own
  // comment says it has no teacherId and no folderId and that nothing should
  // ever give it one; a foreign key from it back to a template would be a
  // teacherId by proxy, and the whole point of that table is that it belongs to
  // StoryJar rather than to a school. Holding the pointer on this side keeps
  // the library row independent of the template that seeded it, so deleting the
  // template leaves the published activity — and every teacher's copy of it —
  // untouched.
  //
  // Unique because the slug is the library's identity: publishing the same
  // template twice must update one row rather than mint a second.
  librarySlug            String?         @unique
  createdAt              DateTime        @default(now())
  assignments            Assignment[]
}

// StoryJar's own published activities, browsable by any signed-in teacher and
// copied into their library on request.
//
// WHY A SEPARATE MODEL RATHER THAN A FLAG ON ActivityTemplate
//
// Every query that builds a teacher's library is scoped
// `where: { teacherId: user.teacher.id }`. With a separate table a shared
// activity cannot appear in a teacher's grid, a count or a folder, because the
// query cannot reach it. A nullable owner with an "is shared" flag would make
// that correctness depend on every present and future query remembering to
// exclude it, and the first one that forgets is the bug. Structure beats
// discipline.
//
// It therefore has NO teacherId and NO folderId, deliberately, and nothing in
// this file should ever give it one.
//
// It holds no child data, no teacher personal data and no teacher-authored
// media. It is StoryJar's own teaching content, published from the repository
// by scripts/ops/publish-shared-activities.mjs. No teacher-authenticated code
// path may write to it; that is asserted in
// tests/battery/security/shared-activities.spec.ts.
model SharedActivity {
  id                String             @id @default(cuid())
  // Stable identity for the publish script. The script upserts on this, which
  // is what makes running it twice create one row rather than two, and what
  // lets an activity be corrected in place without orphaning the copies
  // teachers have already made.
  slug              String             @unique
  title             String
  instructions      String?
  // The same three payload columns ActivityTemplate carries, holding
  // /uploads/shared/<file> paths rather than /uploads/<file> ones.
  templatePathsJson String?
  quizJson          String?
  objectsJson       String?
  tagsJson          String?
  // Suggested age band, using the SJ-06 vocabulary ("EYFS" | "KS1" | "KS2") so
  // there is one register language in this product rather than two.
  //
  // NULL MEANS SOMETHING DIFFERENT HERE, and the difference is deliberate. On
  // Class.ageMode, NULL resolves to EYFS because it decides what a child sees
  // and the youngest register is the protective default. Here it is a browsing
  // hint shown to an adult, so NULL means "no band suggested" and the activity
  // is offered to everybody. Never read this column with resolveAgeMode(),
  // which would silently label every unbanded activity as nursery content.
  ageMode           String?
  // Where this activity came from. "STORYJAR" is ours, authored in the
  // Academy and promoted. It is here now, with one value, because a community
  // hub where teachers submit their own templates is intended later, and that
  // will have to be distinguishable from ours in every screen, every count and
  // every takedown. One column now is cheaper than a migration and a backfill.
  //
  // A community hub is NOT enabled by this column and must not be built on it
  // alone. It needs a StoryJar-side review queue before anything is visible,
  // takedown mechanics, and its own DPIA: a teacher's template can carry a
  // photograph of a child, and no code can tell that from a file.
  origin    String  @default("STORYJAR")
  published         Boolean            @default(false)
  // A deliberate sequence for the library, rather than whatever createdAt gives.
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // The copies teachers have made. Present only so Prisma can express the
  // relation; the operator console may count these and may never read them.
  copies            ActivityTemplate[]
}

// One run of a template against a class (whole class or chosen children).
// Title / instructions / template pages are snapshotted here at assign time so
// later edits to the template never change what a live run shows.
model Assignment {
  id                   String              @id @default(cuid())
  template             ActivityTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId           String
  class                Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId              String
  wholeClass           Boolean             @default(true)
  status               String              @default("LIVE") // LIVE | CLOSED
  title                String // snapshot at assign time
  instructions         String? // snapshot at assign time
  templateSnapshotJson String? // frozen template pages at assign time
  quizSnapshotJson     String? // frozen quiz definition at assign time (mirrors templateSnapshotJson)
  objectsSnapshotJson  String? // frozen movable-objects layer at assign time (mirrors templateSnapshotJson)
  // The PICTURE of the activity, copied at assign time beside the rest. The
  // child's "to do" card showed a striped placeholder while the teacher's
  // library card showed the real thing — the same activity, unrecognisable
  // from one screen to the next.
  //
  // Copied rather than read live through `template`, for the same reason the
  // three fields above it are: a run outlives the template it came from (a
  // CLOSED run keeps what it was set with, and a deleted template would take
  // the picture with it). An edit to a LIVE template is still pushed onto its
  // runs by updateTemplate() — deliberately, so a fix reaches a class today.
  previewSnapshotJson  String?
  dueDate              DateTime? // optional: when the run is expected done; null = no due date (open/historical)
  createdAt            DateTime            @default(now())
  students             AssignmentStudent[] // set only when wholeClass = false
  responses            JournalItem[]
  drafts               Draft[]
}

// An in-progress, unsubmitted draft synced to the account for cross-device
// resume (local-first autosave, Stage 2). Exactly one owner is set: a teacher
// (a new-template draft) OR a student (an activity-response draft). Composite
// pages are stored as MEDIA FILES (like real pages) and only their /uploads
// paths live in pagesJson — never multi-MB data URLs in a column.
//
// SAFEGUARDING: a child's draft is their private unfinished work. It is owner-
// scoped, never visible to parents/other children/other tenants, and never to a
// teacher (a teacher only sees the work once it's submitted as a JournalItem).
// Deletion is real (rows + media files), on submit/publish, on 30-day lazy
// expiry, and on owner cascade. See RETENTION.md.
model Draft {
  id         String   @id @default(cuid())
  surface    String // TEMPLATE_NEW | ACTIVITY_RESPONSE
  contextKey String // "tmpl-new" for a teacher, or the assignmentId for a response
  ownerKey   String // "t:<teacherId>" or "s:<studentId>" — the non-null uniqueness discriminator (nullable FKs alone can't dedupe in SQLite, where NULLs are distinct)
  pagesJson  String? // JSON array of /uploads paths (composite pages saved as media)
  fieldsJson String? // JSON of the wrapper's fields (title/instructions/tags OR caption)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime // now + retention; lazily purged (no cron)

  // Owner + context so cascade deletion and scoping are trivial. All Cascade so
  // a draft dies with its owner (teacher/student/class/assignment).
  teacher      Teacher?    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId    String?
  student      Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String?
  class        Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId      String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String?

  // One draft per (owner, context).
  @@unique([surface, contextKey, ownerKey])
  @@index([expiresAt])
}

// A chosen child on a "pick children" run. (Formerly `ActivityAssignment`.)
model AssignmentStudent {
  id           String     @id @default(cuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

// A skill / standard an item can be tagged against, so the journal doubles
// as assessment evidence. Shared across the whole app.
model Skill {
  id    String        @id @default(cuid())
  name  String        @unique
  items JournalItem[] @relation("JournalItemSkills")
}

// A login session. Points at a teacher, a student, or a parent.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  role      String // TEACHER | STUDENT | PARENT
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String?
  parent    Parent?  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// An append-only record of safeguarding-relevant actions (approvals, returns,
// deletions, staff/role changes) for accountability — SAFEGUARDING.md rule 16.
// Kept deliberately lightweight: actor, action, subject, time and a short note.
model AuditLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  schoolId    String? // for school-scoped viewing (from the actor's school)
  actorType   String // TEACHER | ADMIN | SYSTEM | PARENT (a parent linking their own second child, or adding their own email)
  actorId     String?
  actorName   String?
  action      String // e.g. MOMENT_APPROVED | MOMENT_RETURNED | STAFF_ROLE_CHANGED
  subjectType String? // e.g. JOURNAL_ITEM | STUDENT | TEACHER | CLASS
  subjectId   String?
  detail      String? // short human-readable summary

  @@index([schoolId, at])
}

// ---------------------------------------------------------------------------
// The platform operator (PR1 of the operator programme). NOT a school admin.
// ---------------------------------------------------------------------------
// `Teacher.role = "ADMIN"` already means "admin at this school" and must keep
// meaning only that, so the operator gets its own table, its own session table
// and its own cookie. getCurrentUser() must remain incapable of returning an
// operator and requireOperator() incapable of returning a teacher, student or
// parent; both directions are asserted in
// tests/battery/security/ops-auth.spec.ts (spec A21).
//
// Column names here are deliberately NOT the ones the blindness gate bans.
// Session.token and Teacher.passwordHash are credential names an operator must
// never read, so the operator's own columns are `tokenHash` and `pwHash`, which
// pass the gate's word-boundary matching. That is a naming constraint with a
// zero-cost remedy and it says the true thing: the operator's own secret is a
// different thing from a child's.
//
// Retention: RETENTION.md, "Platform operator account" and "Operator sessions
// and recovery codes". Purpose and residual risks: docs/DPIA.md R15.
model Operator {
  id                String            @id @default(cuid())
  email             String            @unique
  // bcrypt, cost 12 (OPS_BCRYPT_COST in src/lib/ops/passwords.ts).
  pwHash            String
  // Base32 TOTP secret. Stored in plaintext beside the database on the same
  // volume: encrypting it with a key from the environment would place the key
  // on the same host, so it buys less than it appears to. Recorded and accepted
  // in docs/DPIA.md R15 rather than left undocumented.
  totpSecret        String
  totpConfirmedAt   DateTime? // null until the operator has enrolled
  // Monotonic replay protection: a step less than OR EQUAL to this is refused,
  // so an attacker cannot replay the older code that is still inside the window.
  lastTotpStep      Int?
  // Ten single-use recovery codes, bcrypt-hashed, as
  // [{ "hash": "$2b$12$…", "usedAt": null }]. The plaintext is printed once by
  // scripts/seed-operator.ts and lives offline (docs/ops-recovery.md).
  recoveryCodesJson String            @default("[]")
  role              String            @default("OWNER") // OWNER | OPERATOR. One account exists (handbook D11); the split exists so "the last owner is protected" is expressible
  status            String            @default("ACTIVE") // ACTIVE | DISABLED
  // Lockout is persisted on the row, not held in the in-process rate limiter:
  // that store resets on every deploy and every restart, and this is the one
  // door where the attacker gets everything.
  failedAttempts    Int               @default(0)
  lockedUntil       DateTime?
  lastSignInAt      DateTime?
  createdAt         DateTime          @default(now())
  // Named opsSessions, not `sessions`: `sessions` is a relation to the app's
  // Session model elsewhere in this schema, and the blindness gate matches
  // relation names, not types.
  opsSessions       OperatorSession[]
}

// One row per operator browser session. Stores the SHA-256 hash of the cookie
// value and never the value, so a leaked database file is not a set of live
// sessions (the existing Session.token stores raw; that is pre-existing and out
// of scope here, and this deliberately does not copy it).
model OperatorSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  operatorId String
  // PASSWORD = password accepted, TOTP not yet proven; nothing but the sign-in
  // screen is reachable. FULL = both proven. The value is rotated (a new row,
  // a new cookie) at the moment TOTP succeeds, so a pre-auth identifier cannot
  // be fixated.
  stage      String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime // absolute cap; idle is enforced against lastSeenAt

  @@index([operatorId])
}

// The operator's own audit table (handbook ruling R4). Ops never reads
// AuditLog: its `detail` is free text written by teacher-facing actions and
// routinely contains a child's first name, so reading it would be a child-data
// read wearing an operations hat.
model OpsAuditLog {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  actorId        String? // null for a failed sign-in against an unknown address
  actorName      String
  action         String // e.g. OPS_SIGN_IN | OPS_SIGN_IN_FAILED | OPS_TOTP_FAILED
  subjectType    String?
  subjectId      String?
  reason         String? // the operator's stated reason, verbatim, on mutating actions
  detail         String? // never a child's name, never a credential value
  // Unique so QA can force a genuine constraint violation and prove that an
  // audit failure fails the operation (ruling R5), with no fault flag in the
  // product to do it with.
  idempotencyKey String?  @unique

  @@index([at])
}

// ---------------------------------------------------------------------------
// Mail delivery status, and the jobs that keep it current (PR5).
// ---------------------------------------------------------------------------
// Handbook ruling R9 fixes the storage model: "counters and HMAC-keyed
// suppression, and explicitly no address or domain". Owner decision D7, which
// would permit a per-recipient failure record, is unanswered and its published
// default is counters only, so counters only is what these three tables are.
//
// WHY NOT A ROW PER SEND, which is the obvious design and the one brief 03
// asked for. Three reasons, in the order they matter:
//
//   1. A visible list of sign-in failures by address rebuilds, inside StoryJar,
//      the account-enumeration signal that FINDINGS F6 deliberately withholds
//      from the public sign-in form. requestMagicLink answers the same way for
//      an address on file and one that is not; an operator screen listing
//      "delivery failed for ada@example.com" answers the question the form
//      refuses to. Counters cannot.
//   2. It is new personal data about adults on a 5 GB volume that has no
//      backups and holds every child's photograph (owner amendment B1, decision
//      D2 still open). The least data that answers the operational question is
//      the right amount.
//   3. Nothing operational needs it. "Is mail leaving StoryJar this morning"
//      and "is this one parent's address being refused" are both answerable
//      without a per-send row: the first from a tally, the second from a keyed
//      hash of the one address the operator already holds.
//
// None of these tables carries a recipient address, a recipient domain, a
// subject line or a message body. A sign-in email body contains a live token,
// so any code path that could persist a body is a token-disclosure bug, not a
// storage decision.

// One row per run of a scheduled job, so a job that never started is visible.
// Railway's cron does not alert on a non-zero exit and cannot alert at all on a
// run that did not happen, so the absence of a recent SUCCESS row is itself the
// signal (brief 05, "Both jobs must fail loudly").
//
// `outcomeDetail` holds a fixed vocabulary only. Never a recipient, never a
// path, never a count of children.
model JobRun {
  id            String    @id @default(cuid())
  job           String // fixed vocabulary: "mail:suppression-sync" today
  startedAt     DateTime
  finishedAt    DateTime?
  outcome       String // "SUCCESS" | "FAILURE"
  itemsAffected Int       @default(0)
  // A fixed vocabulary, never free text. Named outcomeDetail rather than the
  // obvious `note` because the blindness gate refuses a column whose name ends
  // in "note": AuditLog and JournalItem both carry notes that routinely hold a
  // child's first name, and a rule that has to know which `note` is which is a
  // rule that will one day guess wrong.
  outcomeDetail String?

  @@index([job, startedAt])
}

// A per-day, per-template, per-outcome tally of send ATTEMPTS, written from
// inside src/lib/mailer.ts by src/lib/mailCounters.ts. It says the same
// operational thing a delivery log would say without holding a row about a
// person: there is no address here, no domain, and no way to get from a row
// back to a family.
//
// `statusClass` is an empty string rather than NULL when there is nothing to
// say. SQLite treats NULLs as distinct in a unique constraint, so a nullable
// column in the key silently produces duplicate rows on upsert instead of
// incrementing the one that is already there.
//
// The vocabulary of all four key columns is closed and lives in
// src/lib/ops/mail.ts. The provider's own error strings are mapped onto it and
// never stored, so a provider that one day starts putting an address in a
// rejection message cannot put one in here.
model MailCounter {
  day         String // "YYYY-MM-DD", UTC
  // Named templateKey rather than `template` because `template` is a RELATION
  // to ActivityTemplate elsewhere in this schema, and the blindness gate
  // derives its child-relation denylist from relation names: an operator file
  // mentioning `template` is refused, whichever thing it meant. The gate cannot
  // tell a mail template from a child's activity template and should not try.
  templateKey String // "magic-link"
  outcome     String // "SENT" | "FAILED" | "UNCONFIGURED"
  statusClass String // "" | "4xx" | "5xx" | "other" | "rejected" | "timeout" | "network"
  count       Int    @default(0)

  @@id([day, templateKey, outcome, statusClass])
}

// One row per address the provider is refusing, keyed by an HMAC-SHA256 of the
// address under MAIL_HMAC_KEY, which lives in the environment and not in this
// repository.
//
// A plain hash of an email address is not a de-identification measure: the
// space of real addresses is small enough to walk with a dictionary, so an
// unkeyed digest is the address with extra steps. The key is what makes this
// row useless to somebody holding a copy of the database file and nothing else.
//
// It is a one-way column on purpose. An operator can ask "is THIS address, which
// I already have in front of me, being refused", by hashing it server-side from
// the stored adult record. Nobody can ask "which addresses are being refused",
// because that list is a list of adults locked out of their children's work and
// nothing operational needs it.
model MailSuppression {
  id          String   @id @default(cuid())
  addressHmac String   @unique
  state       String // "BOUNCE" | "BLOCKED" | "SPAM" | "UNSUBSCRIBED"
  firstSeenAt DateTime
  lastSeenAt  DateTime
}

// ---------------------------------------------------------------------------
// Connecting Claude to a teacher's activity library.
// ---------------------------------------------------------------------------
// A teacher can point Claude at StoryJar and ask it to build an activity —
// "take this worksheet and turn it into a four-page quiz". Claude reaches the
// product through an MCP server (src/app/api/mcp) and a small REST API
// (src/app/api/v1), both authenticated by one of the tokens below.
//
// WHAT A TOKEN CAN REACH, AND WHY THAT LIST IS SHORT
//
// A token reads and writes ONE teacher's activity templates and folders. It
// cannot reach a class, a child, a journal item, a draft, the approval queue or
// any uploaded media — not because the API declines to offer those routes, but
// because src/lib/api/ never queries those models at all. There is no scope
// system to misconfigure and no flag that widens it: a route that wanted child
// data would have to be written, reviewed and merged.
//
// That is a deliberate reading of SAFEGUARDING rule 1. A child's work reaching
// a third party over a bearer token, outside the approval queue, is precisely
// the shape of change the queue exists to prevent — so the connector stops at
// the teaching material and a human still opens the canvas, looks at what
// Claude made, and decides whether a class ever sees it.
//
// Retention: RETENTION.md, "Connector tokens". Purpose and residual risks:
// docs/DPIA.md R17.

// One bearer token. Either minted by the teacher on their own account page
// (kind = PERSONAL, for Claude Code / Claude Desktop) or issued by the OAuth
// flow when they add StoryJar as a connector on claude.ai (kind = OAUTH).
//
// Only the SHA-256 of the token is stored (`keyHash`), so a copy of the database
// file is
// not a set of live tokens (this follows OperatorSession.tokenHash rather than
// the older Session.token, which stores raw). `hint` is the first few
// characters of the token — enough for a teacher to tell two rows apart on the
// account page, useless to anyone holding only the row.
model ApiToken {
  id         String      @id @default(cuid())
  // The teacher's own words: "Claude on my laptop". Never shown to anyone else.
  label      String
  // Named keyHash, not tokenHash: OperatorSession already owns `tokenHash`, and
  // the ops blindness gate's denylist is keyed on the column NAME. Denylisting
  // one name would either break the operator's own sign-in or leave this one
  // unprotected, so the two credentials get two names and both are classified.
  keyHash    String      @unique
  // The four characters after the fixed `sj_live_` prefix — enough for a teacher
  // to tell two rows apart on their account page, and not a credential: the
  // prefix is constant and four characters of a 43-character secret identify
  // nothing. Deliberately NOT on the ops denylist, and deliberately not longer.
  hint       String
  // REVOKING IS DELETING, on both of these tables and on OAuthGrant. There is no
  // `revokedAt` flag, deliberately: a row that is merely marked revoked still
  // holds a hash somebody could match, and every read would then depend on
  // remembering the filter. Deleting the row means the credential does not exist
  // anywhere — a teacher revoking a token, a connector rotating its access
  // token, and a replayed authorization code all end the same way.
  kind       String      @default("PERSONAL") // PERSONAL | OAUTH
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId  String
  // Set only on kind = OAUTH. Cascade, so revoking a connector on the account
  // page takes its access tokens with it rather than leaving them live.
  oauthGrant OAuthGrant? @relation(fields: [grantId], references: [id], onDelete: Cascade)
  grantId    String?
  createdAt  DateTime    @default(now())
  expiresAt  DateTime? // null on a personal token; set on an OAuth access token
  // Coarse, and coarse on purpose: a teacher needs to know whether a token they
  // have forgotten about is still being used before they revoke it. It is
  // written at most once an hour (see touchApiToken) so it never becomes a log
  // of when a teacher works.
  lastUsedAt DateTime?

  @@index([teacherId])
  @@index([grantId])
}

// A claude.ai connector, registered by Claude itself through RFC 7591 dynamic
// client registration. Holds no secret: the flow is public-client + PKCE, which
// is what MCP requires and what removes any client secret from this table.
model OAuthClient {
  id               String       @id @default(cuid()) // the client_id
  name             String // the client's self-declared name, shown on the consent screen
  redirectUrisJson String // JSON array of exact redirect URIs, matched exactly
  createdAt        DateTime     @default(now())
  grants           OAuthGrant[]
}

// One teacher's decision to let one client in, and the credentials that carry
// that decision: first a single-use authorization code, then a refresh token.
// Both are stored hashed, for the same reason ApiToken.keyHash is.
model OAuthGrant {
  id            String      @id @default(cuid())
  oauthClient   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  teacher       Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId     String
  redirectUri   String // the one this grant was authorised against; the token call must match it
  // Authorization-code stage. Single use: codeUsedAt is stamped on redemption
  // and a second attempt revokes the whole grant (RFC 6749 §10.5).
  codeHash      String?     @unique
  codeChallenge String? // PKCE S256 challenge; plain is refused
  codeExpiresAt DateTime?
  codeUsedAt    DateTime?
  // Refresh stage. Rotated on every use, so a stolen refresh token stops
  // working the moment the real client uses its own.
  refreshHash   String?     @unique
  createdAt     DateTime    @default(now())
  accessTokens  ApiToken[]

  @@index([teacherId])
}
// One open, primary-facing English establishment, imported from the DfE's GIAS
// all-establishments CSV by scripts/gias-import.ts. Public reference data about
// an INSTITUTION: there is no person in this table, no foreign key to one, and
// no route from a row here back to a teacher, a parent or a child.
//
// It is a register, not a service. Nothing calls GIAS at runtime — the CSV is
// downloaded and parsed by a person running a command, which is why there is no
// sub-processor to declare (docs/DPIA.md) and no retention clock to run
// (RETENTION.md: no data subject, replaced wholesale on each import).
//
// SIX COLUMNS, AND DELIBERATELY NO SEVENTH. GIAS also publishes each school's
// website and telephone number; neither is needed once domain matching is off
// the table (docs/school-identity.md), and a field nobody reads is a field
// somebody later decides to display. That rule is why there is no lower-cased
// name column and no space-free postcode column here either: prefix search
// normalises the QUERY instead (src/lib/establishmentSearch.ts), which cannot drift
// out of step with the row the way a derived column can.
//
// `urn` is the Unique Reference Number the DfE assigns, and it is the whole
// point of the table: two teachers typing "St Bede's Primary" and "St Bedes
// CofE Primary School" are the same school here and nowhere else in StoryJar.
//
// STALENESS IS ACCEPTED. Schools open, close and merge under new URNs, and a
// hand-run import is a snapshot. A real school missing from the register must
// still be able to sign up, which is why signup keeps its free-text field as a
// first-class path rather than a degraded one.
model Establishment {
  // The DfE's URN, not a cuid: the row IS the establishment, and a surrogate
  // key would let one school in twice under two ids.
  urn            String @id
  name           String // EstablishmentName, verbatim
  // Postcode does the disambiguating work in the picker — there are dozens of
  // St Mary's Primary Schools. Stored exactly as GIAS prints it.
  postcode       String
  localAuthority String // LA (name)
  phase          String // PhaseOfEducation (name): Primary, Middle deemed primary, All-through
  town           String // Town, falling back to Locality — GIAS populates Town far more reliably

  @@index([name])
  @@index([postcode])
}
