# Storyjar environment — copy to `.env` and fill in. NEVER commit real values.
# Secrets come from the environment only (SAFEGUARDING.md rule 12).

# --- Core ---
# SQLite in dev; a UK/EU-hosted database in production (SAFEGUARDING rule 10).
DATABASE_URL="file:./dev.db"

# Where uploaded children's media is stored (private dir, served via /uploads).
# MEDIA_DIR="/data/media"

# Absolute base URL of the app, used to build Stripe return links. Optional in
# dev (derived from the request host); set it in production.
# APP_URL="https://storyjar.co.uk"

# --- Transactional email (Mailjet) ---
# Mailjet (Sinch) processes ADULT email addresses only (parents and staff),
# never child data, and no child's name ever appears in an email body.
# EU storage only. Listed on /legal/sub-processors and in docs/DPIA.md.
MAILJET_API_KEY="..."
MAILJET_SECRET_KEY="..."

# Sender must be on the validated sending domain (SPF + DKIM), NOT the root
# domain, so outbound auth mail never shares reputation with inbound forwarding.
EMAIL_FROM_ADDRESS="hello@mail.storyjar.co.uk"
EMAIL_FROM_NAME="Storyjar"
# Where a parent's reply actually lands — a real, monitored mailbox.
EMAIL_REPLY_TO="hello@storyjar.co.uk"

# --- Billing (Stripe) ---
# Stripe processes ADULT billing data only (teacher name/email or school name).
# No child data is ever sent to Stripe. See README "Billing" for setup.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs created in Stripe (test/live). GBP, VAT-inclusive. See the README for
# the Stripe CLI commands that create these.
# Storyjar's only purchasable plan is School, in four bands by pupils on roll.
# Every band is quantity 1 — the band IS the price, nothing meters pupils.
# The teacher plan is free and never reaches Stripe, so it has no price id.
STRIPE_PRICE_SCHOOL_SMALL="price_..."         # £199 / year — up to 105 pupils
STRIPE_PRICE_SCHOOL_1FE="price_..."           # £299 / year — up to 210 pupils
STRIPE_PRICE_SCHOOL_2FE="price_..."           # £449 / year — up to 420 pupils
STRIPE_PRICE_SCHOOL_LARGE="price_..."         # £649 / year — over 420 pupils

# Apple Pay domain-association file contents, from the Stripe dashboard
# (Payment methods → Apple Pay → your domain). Served at
# /.well-known/apple-developer-merchantid-domain-association. Not secret.
STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=""
